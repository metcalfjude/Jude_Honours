@article{timashev_anomalous_2009,
	title = {Anomalous diffusion in the dynamics of complex processes},
	volume = {3},
	copyright = {https://www.springernature.com/gp/researchers/text-and-data-mining},
	issn = {1990-7931, 1990-7923},
